From 3c336bfac7e88a40bc8357966f9982e75076f3bb Mon Sep 17 00:00:00 2001
From: Luan Rafael Carneiro <luan.r@variscite.com>
Date: Thu, 10 Apr 2025 19:23:05 -0300
Subject: [PATCH] src/meson.build: Change wayland-scanner to use native

Signed-off-by: Luan Rafael Carneiro <luan.r@variscite.com>
---
 src/meson.build | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/meson.build b/src/meson.build
index a8a1d2b..c114feb 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -79,7 +79,7 @@ endif

 if meson.is_cross_build() or not get_option('scanner')
 	scanner_dep = dependency('wayland-scanner', native: true, version: meson.project_version())
-	wayland_scanner_for_build = find_program(scanner_dep.get_variable(pkgconfig: 'wayland_scanner'))
+	wayland_scanner_for_build = find_program('wayland-scanner', native: true, required: true)
 else
 	wayland_scanner_for_build = wayland_scanner
 endif
--
2.44.2

